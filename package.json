{
  "name": "@dai-works/dai-runner",
  "version": "2.2.0",
  "description": "軽量フロントエンドビルドツール - SCSS、JavaScript、画像ファイルの処理と最適化",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dai-runner": "./bin/dai-runner.js"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "predev": "node scripts/precheck.js",
    "prebuild": "node scripts/precheck.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/unit/*.test.js",
    "smoke": "node test/smoke/run.js",
    "check": "npm run lint && npm run format:check && npm test && npm run smoke",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "build-tool",
    "frontend",
    "scss",
    "sass",
    "bundler",
    "image-optimization",
    "browsersync",
    "wordpress",
    "theme",
    "static-site",
    "landing-page"
  ],
  "author": "Dai Works",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dai-works/dai-runner.git"
  },
  "bugs": {
    "url": "https://github.com/dai-works/dai-runner/issues"
  },
  "homepage": "https://github.com/dai-works/dai-runner#readme",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "browser-sync": "^3.0.4",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cssnano": "^8.0.10",
    "glob": "^13.0.6",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.26",
    "postcss-discard-duplicates": "^8.0.4",
    "postcss-normalize-charset": "^8.0.5",
    "postcss-sort-media-queries": "^6.7.1",
    "rollup": "^4.63.1",
    "sass": "^1.103.1",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "files": [
    "bin/",
    "scripts/",
    "tasks/",
    "utils/",
    "dai-runner.config.js.example",
    "dai-runner.config.local.js.example",
    "index.js",
    "README.md",
    "CHANGELOG.md"
  ]
}
