/**
 * プロジェクトの設定を管理するコンフィグオブジェクト
 *
 * @property {Object} paths - アセットの入出力パス設定
 * @property {Object} dev - 開発環境の設定
 * @property {Object} build - 本番環境の設定
 */

// ローカル設定を読み込み（個人環境依存の設定）
let localConfig = {};
try {
  const module = await import('./dai-runner.config.local.js');
  localConfig = module.default || {};
} catch (_e) {
  // ローカル設定がない場合はデフォルト値を使用
}

export const config = {
  // パス設定（ソースとビルド後のディレクトリを定義）
  paths: {
    images: {
      src: 'source/images',
      dist: 'public/assets/images',
    },
    js: {
      src: 'source/js',
      dist: 'public/assets/js',
    },
    css: {
      src: 'source/scss',
      dist: 'public/assets/css',
    },
  },

  // クリーンアップ設定
  cleanup: {
    // クリーンアップから除外するファイルやディレクトリを指定
    // テーマルートからの相対パスで指定（distディレクトリを含む完全なパス）
    excludeFiles: [
      // 'public/assets/images/keep-image.png',
      // 'public/assets/js/keep-js.js',
      // 'public/assets/css/keep-css.css',
    ],
    // true: 画像キャッシュ有効時でも src 側に存在しない dist 画像（孤立ファイル）を削除する
    // false: キャッシュ有効時は dist の画像を一切削除しない（旧来の挙動）
    // 「sourceから消した画像が assets に残り続ける」問題を防ぐためデフォルト true
    cleanOrphans: true,
  },

  // 開発サーバーの監視から追加で除外するパターン
  watchOptions: {
    ignored: [],
  },

  // 本番アップロード用パッケージング設定（`dai-runner package` コマンドで使用）
  // include は「上書き」、exclude は dai-runner のデフォルトに「追加」される
  package: {
    outputDir: 'dist/theme', // 出力先ディレクトリ
    zip: false, // CLI の --zip より優先度低
    zipName: 'theme.zip', // zip 化したときのファイル名
    // include を指定するとデフォルト（assets/**, includes/**, *.php など）が完全に置き換わる
    // include: [
    //   'assets/**',
    //   'includes/**',
    //   'template-parts/**',
    //   'page-parts/**',
    //   '*.php',
    //   'style.css',
    //   'screenshot.png',
    // ],
    // exclude はデフォルト除外（page-snippets.php, .DS_Store など）に追加される
    exclude: [
      // 'docs/**',
      // 'CLAUDE.md',
    ],
  },

  // 画像最適化設定（開発・本番共通）
  images: {
    convertToWebp: true, // true: WebP形式に変換, false: 元の形式のまま
    convertToAvif: false, // true: AVIF も生成（<source type="image/avif"> 用）。既定は無効
    imageQuality: 80, // 画質（1-100 / JPEG・PNG・WebP）
    avifQuality: 60, // AVIF画質（WebP80と同等の見た目基準。高効率なため数値は低め）
    maxWidth: 3840, // 最大幅（px）
    concurrency: 4, // 同時に処理する画像の数（初回ビルドの速さ。コア数程度まで）
    // 最適化から除外したいファイルがある場合は以下のコメントのように設定
    // （例：動くpng画像など）
    excludeFromOptimization: [
      // 'sample.png',
      // 'sample.jpg',
    ],
  },

  // sitemap.xml生成設定（本番ビルド時のみ）
  sitemap: {
    enabled: false, // true: sitemap.xmlを生成, false: 生成しない
    productionUrl: 'https://example.com', // 本番環境のURL（末尾のスラッシュは不要）
    sourceDir: 'public', // HTMLファイルの検索元ディレクトリ
    outputPath: 'public/sitemap.xml', // sitemap.xmlの出力先
    excludePatterns: [
      // sitemap.xmlから除外したいファイルパターン
      // '404.html',
      // 'test/**',
    ],
    defaultPriority: 0.5, // デフォルトの優先度（0.0-1.0）※トップページは自動的に1.0
    defaultChangefreq: 'weekly', // デフォルトの更新頻度（always/hourly/daily/weekly/monthly/yearly/never）
    // 特定のページに個別の優先度を設定（オプション）
    customPriorities: {
      // '/service/': 0.8,         // service/index.html（重要なサービスページ）
      // '/products/': 0.8,        // products/index.html（商品ページ）
      // '/about.html': 0.8,       // about.html（会社概要）
      // '/blog/': 0.3,            // blog/index.html（ブログ一覧）
    },
  },

  // 開発環境設定
  dev: {
    // mode と proxy は dai-runner.config.local.js で設定されます
    // 初回実行時に自動的に作成されます
    mode: localConfig.mode || 'server',
    server: { baseDir: 'public' },
    proxy: localConfig.proxy || {
      target: 'http://127.0.0.1',
      proxyReq: [],
    },
    options: {
      js: {
        minify: false, // true: コードを圧縮, false: 整形したまま
        sourceMap: true, // true: ソースマップを生成, false: 生成しない
        bundle: true, // true: バンドルする, false: 個別に処理する
        dropConsole: false, // true: console.log等を削除, false: console.logを残す
      },
      css: {
        minify: false, // true: CSSを圧縮, false: 整形したまま
        sourceMap: true, // true: ソースマップを生成, false: 生成しない
      },
      images: {
        useCache: true, // true: キャッシュを使用（高速化）, false: 毎回処理
      },
      logLevel: 'info', // ログレベル: 'debug' | 'info' | 'warn' | 'error'
      // true: source・設定・dai-runner に変更が無ければ dev 起動時の CSS/JS ビルドを飛ばす
      incremental: true,
    },
  },

  // 本番環境設定
  build: {
    options: {
      js: {
        minify: false, // true: コードを圧縮, false: 整形したまま
        sourceMap: false, // true: ソースマップを生成, false: 生成しない
        bundle: true, // true: バンドルする, false: 個別に処理する
        dropConsole: true, // true: console.log等を削除, false: console.logを残す
      },
      css: {
        minify: false, // true: CSSを圧縮, false: 整形したまま
        sourceMap: false, // true: ソースマップを生成, false: 生成しない
      },
      images: {
        useCache: false, // true: キャッシュを使用（高速化）, false: 毎回処理
      },
      logLevel: 'info', // ログレベル: 'debug' | 'info' | 'warn' | 'error'
    },
    // 本番ビルド時のみsitemap.xmlを生成する場合はここで設定を上書き
    // sitemap: {
    //   enabled: true,
    //   productionUrl: 'https://example.com',
    // },
  },

  /**
   * 指定された環境の設定を取得
   * @param {string} env - 環境名（dev or build）
   * @returns {Object} 環境設定
   */
  get(env = process.env.NODE_ENV || 'dev') {
    const conf = this[env] || this.dev;
    return {
      ...conf,
      paths: this.paths,
      cleanup: this.cleanup,
      watchOptions: this.watchOptions,
      sitemap: conf.sitemap || this.sitemap, // 環境固有のsitemap設定を優先
      options: {
        ...conf.options,
        images: {
          ...this.images,
          ...conf.options.images, // 環境固有の設定で上書き
        },
      },
    };
  },
};
